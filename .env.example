# Copy to .env and fill in. NEVER commit .env.
# Postgres connection (dev pilot may use a local database).
DATABASE_URI=postgres://localhost:5432/techpresso_dev
# Payload secret — random long string, used to sign/encrypt. Generate your own.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# (Later phases) translation LLM provider key — added in Phase 5, not committed.
# LLM_API_KEY=
